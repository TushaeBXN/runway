generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  createdAt    DateTime      @default(now())
  orgProfile   OrgProfile?
  subscription Subscription?
  settings     UserSettings?
  tasks        Task[]
  documents    Document[]
}

model OrgProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  orgName    String
  location   String
  mission    String
  focusAreas String
  website    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  llmProvider  String  @default("ollama")
  anthropicKey String?
  openaiKey    String?
  geminiKey    String?
  ollamaHost   String  @default("http://localhost:11434")
  ollamaModel  String  @default("llama3.2:3b")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String
  status       String    @default("todo")
  category     String    @default("General")
  scheduledFor String    @default("Tonight")
  agentId      String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  status               String    @default("trialing")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  agentName String
  status    String
  output    String
  ranAt     DateTime @default(now())
}

model GrantOpportunity {
  id           String   @id @default(cuid())
  title        String
  funder       String
  missionScore Int
  deadline     String
  amount       String
  url          String?
  hook         String
  kpis         Json
  budget       Json
  checklist    Json
  rawOutput    String
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id      String   @id @default(cuid())
  time    DateTime @default(now())
  agentId String
  label   String
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}

model UpworkJob {
  id            String   @id @default(cuid())
  title         String
  budget        String
  description   String
  skills        String
  score         Int
  status        String   @default("pending")
  earnings      Float    @default(0)
  assignedAgent String?
  upworkUrl     String?
  deliverable   String?
  createdAt     DateTime @default(now())
}

model HardwareFund {
  id          String   @id @default(cuid())
  totalEarned Float    @default(0)
  currentTier String   @default("tier0")
  notes       String?
  updatedAt   DateTime @default(now())
}

model PendingApproval {
  id          String   @id @default(cuid())
  agentId     String
  agentName   String
  actionType  String   // "email" | "social_post" | "job_deliverable" | "grant_strategy"
  title       String
  description String
  payload     String   // JSON blob — the full draft content
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  userNote    String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
}

// Synced from Equilibrium-Claw OS via /api/session
model AgentSession {
  id        String   @id @default(cuid())
  agentId   String   @unique
  lastRun   DateTime?
  runCount  Int      @default(0)
  memory    String   @default("{}")
  log       String   @default("[]")
  updatedAt DateTime @updatedAt
}
