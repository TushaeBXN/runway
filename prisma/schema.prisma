generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  createdAt    DateTime      @default(now())
  orgProfile   OrgProfile?
  subscription Subscription?
  settings     UserSettings?
  tasks        Task[]
  documents    Document[]
}

model OrgProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  orgName    String
  location   String
  mission    String
  focusAreas String
  website    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  llmProvider  String  @default("anthropic")
  anthropicKey String?
  ollamaHost   String  @default("http://localhost:11434")
  ollamaModel  String  @default("llama3.2")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String
  status       String    @default("todo")
  category     String    @default("General")
  scheduledFor String    @default("Tonight")
  agentId      String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  status               String    @default("trialing")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  agentName String
  status    String
  output    String
  ranAt     DateTime @default(now())
}

model GrantOpportunity {
  id           String   @id @default(cuid())
  title        String
  funder       String
  missionScore Int
  deadline     String
  amount       String
  url          String?
  hook         String
  kpis         Json
  budget       Json
  checklist    Json
  rawOutput    String
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id      String   @id @default(cuid())
  time    DateTime @default(now())
  agentId String
  label   String
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}
